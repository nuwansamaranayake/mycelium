# ---- LLM via OpenRouter (required) ----
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick model IDs by task from https://openrouter.ai/models
LLM_MODEL_REASONING=REPLACE_WITH_OPENROUTER_MODEL_ID
LLM_MODEL_EXTRACTION=REPLACE_WITH_OPENROUTER_MODEL_ID
LLM_MODEL_JUDGE=REPLACE_WITH_OPENROUTER_MODEL_ID
EMBEDDING_MODEL=REPLACE_WITH_OPENROUTER_MODEL_ID
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- Runtime ----
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SMOKE_TEST_TOKEN=dev-smoke-token

# ---- Data (required) ----
DATABASE_URL=postgresql+psycopg://aignite:aignite@localhost:5432/mycelium
REDIS_URL=redis://localhost:6379/0
EXPECTED_TABLE_COUNT=9

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mycelium

# Knowledge and chat connectors (all optional; synthetic corpus is the default)
CONFLUENCE_BASE_URL=https://example.invalid
CONFLUENCE_API_TOKEN=REPLACE_ME
NOTION_API_KEY=REPLACE_ME
GOOGLE_DRIVE_CREDENTIALS_JSON=/path/to/credentials.json
SLACK_BOT_TOKEN=REPLACE_ME
GITHUB_TOKEN=REPLACE_ME
# Object storage for ingested source versions (MinIO in compose)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aignite
S3_SECRET_KEY=aignite-secret
S3_BUCKET=mycelium
